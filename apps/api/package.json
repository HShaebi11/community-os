{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/ensure-cf-plugin.mjs && cf dev",
    "build": "node ../../scripts/ensure-cf-plugin.mjs && cf build",
    "deploy": "cf deploy",
    "start:node": "tsx src/node.ts",
    "test": "vitest run",
    "typecheck": "cf workers types && tsc --noEmit",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov"
  },
  "dependencies": {
    "@community-os/core": "0.1.0",
    "@community-os/db": "0.1.0",
    "@community-os/mcp": "0.1.0",
    "@community-os/server": "0.1.0",
    "@community-os/whatsapp-import": "0.1.0",
    "@hono/node-server": "^2.1.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@types/node": "^24.9.2",
    "cf": "^1.0.0-beta.18",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^3.2.4",
    "@community-os/testkit": "0.1.0",
    "@community-os/sdk": "0.1.0",
    "@community-os/store-sqlite": "0.1.0",
    "@community-os/channel-slack": "0.1.0"
  }
}
