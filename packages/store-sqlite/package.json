{
  "name": "@community-os/store-sqlite",
  "version": "0.1.0",
  "description": "SQLite Store adapter for Community OS — durable embedded storage via node:sqlite, zero deps",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov"
  },
  "peerDependencies": {
    "@community-os/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@community-os/sdk": "0.1.0",
    "@types/node": "^24.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
