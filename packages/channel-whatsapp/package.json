{
  "name": "@community-os/channel-whatsapp",
  "version": "0.1.0",
  "description": "WhatsApp channel adapters for Community OS — Baileys live listener + official Cloud API webhook receiver",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov"
  },
  "peerDependencies": {
    "@community-os/sdk": "^0.1.0",
    "@whiskeysockets/baileys": "^6.7.0"
  },
  "peerDependenciesMeta": {
    "@whiskeysockets/baileys": {
      "optional": true
    }
  },
  "devDependencies": {
    "@community-os/sdk": "0.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@community-os/testkit": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
