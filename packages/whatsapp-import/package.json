{
  "name": "@community-os/whatsapp-import",
  "version": "0.1.0",
  "description": "WhatsApp export parser for Community OS — .txt/.zip chat exports → transcript, messages, and media files",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov"
  },
  "devDependencies": {
    "@community-os/core": "0.1.0",
    "fflate": "^0.8.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "@community-os/testkit": "0.1.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
